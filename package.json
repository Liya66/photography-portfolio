{
  "name": "liya-wang-photography",
  "private": true,
  "scripts": {
    "dev": "npm-run-all --parallel dev:css dev:serve",
    "dev:css": "tailwindcss -i ./src/input.css -o ./dist/output.css --watch",
    "dev:serve": "serve -l 3000 .",
    "build": "tailwindcss -i ./src/input.css -o ./dist/output.css --minify"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5",
    "serve": "^14.2.4",
    "tailwindcss": "^3.4.17"
  }
}
